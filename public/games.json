ach(v=>{let d=document.createElement('div');d.className='cell'+(v>0?' c-'+v:'');d.innerText=v>0?v:'';b.appendChild(d);});document.getElementById('sc').innerText=sc;}function slide(r){let f=r.filter(x=>x!==0);for(let i=0;i<f.length-1;i++){if(f[i]===f[i+1]){f[i]*=2;sc+=f[i];f[i+1]=0;}}f=f.filter(x=>x!==0);while(f.length<4)f.push(0);return f;}function move(d){let chg=false;if(d==='left'||d==='right'){for(let r=0;r<4;r++){let row=[g[r*4],g[r*4+1],g[r*4+2],g[r*4+3]];if(d==='right')row.reverse();let res=slide(row);if(d==='right')res.reverse();for(let c=0;c<4;c++){if(g[r*4+c]!==res[c])chg=true;g[r*4+c]=res[c];}}}else{for(let c=0;c<4;c++){let col=[g[c],g[c+4],g[c+8],g[c+12]];if(d==='down')col.reverse();let res=slide(col);if(d==='down')res.reverse();for(let r=0;r<4;r++){if(g[r*4+c]!==res[r])chg=true;g[r*4+c]=res[r];}}}if(chg){spawn();render();}}window.addEventListener('keydown',e=>{if(['ArrowLeft','KeyA'].includes(e.code))move('left');if(['ArrowRight','KeyD'].includes(e.code))move('right');if(['ArrowUp','KeyW'].includes(e.code))move('up');if(['ArrowDown','KeyS'].includes(e.code))move('down');});document.getElementById('rst').addEventListener('click',init);init();<\/script></body></html>"
