et segments=[],keys={};window.addEventListener('keydown',e=>{keys[e.code]=true;if(e.code==='Space'&&state==='playing'&&!ball.jumping){ball.vy=9;ball.jumping=true;}});window.addEventListener('keyup',e=>{keys[e.code]=false;});function initTrack(){segments=[];distance=0;speed=1.2;ball={x:0,y:0,z:0,vx:0,vy:0,r:18,jumping:false};for(let i=0;i<45;i++)addSegment(i*40);}function addSegment(z){let hasObs=z>200&&Math.random()<0.45;segments.push({z,w:240+Math.sin(z*0.01)*30,hasObs,obsX:(Math.random()-0.5)*160,obsW:40+Math.random()*30});}function start(){initTrack();state='playing';document.getElementById('overlay').style.display='none';}document.getElementById('startBtn').addEventListener('click',start);function die(){state='dead';if(distance>best){best=Math.floor(distance);localStorage.setItem('slope_best',best);document.getElementById('bestVal').innerText=best;}document.getElementById('ovTitle').innerText='CRASHED!';document.getElementById('ovDesc').innerText='Distance: '+Math.floor(distance)+'m\\nBest: '+best+'m';document.getElementById('startBtn').innerText='RETRY';document.getElementById('overlay').style.display='flex';}let lastTime=performance.now();function loop(now){requestAnimationFrame(loop);let dt=(now-lastTime)/1000;lastTime=now;if(dt>0.1)dt=0.1;ctx.fillStyle='#070913';ctx.fillRect(0,0,w,h);if(state==='playing'){let move=0;if(keys['ArrowLeft']||keys['KeyA'])move-=1;if(keys['ArrowRight']||keys['KeyD'])move+=1;ball.vx+=move*600*dt;ball.vx*=0.86;ball.x+=ball.vx*dt;if(ball.jumping){ball.y+=ball.vy;ball.vy-=22*dt;if(ball.y<=0){ball.y=0;ball.jumping=false;ball.vy=0;}}let advance=speed*280*dt;distance+=advance*0.1;speed+=dt*0.015;document.getElementById('distVal').innerText=Math.floor(distance);document.getElementById('spdVal').innerText=Math.floor(speed*100);for(let s of segments)s.z-=advance;while(segments[0]&&segments[0].z<-40){segments.shift();addSegment(segments[segments.length-1].z+40);}let cur=segments.find(s=>s.z>=-10&&s.z<=30);if(cur){if(Math.abs(ball.x)>cur.w/2)die();if(cur.hasObs&&ball.y<20&&Math.abs(ball.x-cur.obsX)<cur.obsW/2+10)die();}}let cx=w/2,cy=h/2+50,fov=350;for(let i=segments.length-1;i>=0;i--){let s=segments[i];if(s.z<=0)continue;let scale=fov/(s.z+fov),sx=cx,sy=cy+120*scale,sw=s.w*scale;ctx.strokeStyle='#00f0ff';ctx.lineWidth=Math.max(1,2.5*scale);ctx.beginPath();ctx.moveTo(sx-sw/2,sy);ctx.lineTo(sx+sw/2,sy);ctx.stroke();ctx.fillStyle='rgba(0,240,255,0.03)';ctx.fillRect(sx-sw/2,sy,sw,8*scale);if(s.hasObs){let ox=cx+s.obsX*scale,ow=s.obsW*scale,oh=40*scale;ctx.fillStyle='#ff0055';ctx.fillRect(ox-ow/2,sy-oh,ow,oh);}}let pScale=fov/(0+fov),px=cx+ball.x*pScale,py=cy+120*pScale-ball.y*pScale-ball.r;ctx.fillStyle='#38bdf8';ctx.beginPath();ctx.arc(px,py,ball.r,0,Math.PI*2);ctx.fill();}requestAnimationFrame(loop);<\/script></body></html>"
