xtDir={x:0,y:-1};if(['ArrowDown','KeyS'].includes(e.code)&&dir.y===0)nextDir={x:0,y:1};if(['ArrowLeft','KeyA'].includes(e.code)&&dir.x===0)nextDir={x:-1,y:0};if(['ArrowRight','KeyD'].includes(e.code)&&dir.x===0)nextDir={x:1,y:0};});function start(){snake=[{x:10,y:10},{x:9,y:10},{x:8,y:10}];dir={x:1,y:0};nextDir={x:1,y:0};score=0;document.getElementById('score').innerText=0;spawnFood();running=true;document.getElementById('overlay').style.display='none';if(timer)clearInterval(timer);timer=setInterval(tick,90);}document.getElementById('startBtn').addEventListener('click',start);function die(){running=false;clearInterval(timer);if(score>best){best=score;localStorage.setItem('snake_best',best);document.getElementById('best').innerText=best;}document.getElementById('ovTitle').innerText='GAME OVER';document.getElementById('ovDesc').innerText='Score: '+score;document.getElementById('overlay').style.display='flex';}function tick(){dir=nextDir;let head={x:snake[0].x+dir.x,y:snake[0].y+dir.y};if(head.x<0||head.x>=GRID||head.y<0||head.y>=GRID||snake.some(s=>s.x===head.x&&s.y===head.y)){die();return;}snake.unshift(head);if(head.x===food.x&&head.y===food.y){score+=10;document.getElementById('score').innerText=score;spawnFood();}else{snake.pop();}ctx.fillStyle='#091319';ctx.fillRect(0,0,440,440);ctx.fillStyle='#ef4444';ctx.beginPath();ctx.arc(food.x*TILE+TILE/2,food.y*TILE+TILE/2,TILE*0.38,0,Math.PI*2);ctx.fill();snake.forEach((s,i)=>{ctx.fillStyle=i===0?'#34d399':'#10b981';ctx.fillRect(s.x*TILE+2,s.y*TILE+2,TILE-4,TILE-4);});}tick();<\/script></body></html>"
